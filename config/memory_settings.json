    "normal_expiry_days": 7,
    "promote_after_accesses": 5,
    "decay_after_days_no_access": 30
  },

  "learning": {
    "favorite_threshold": 5,
    "track_apps": true,
    "track_folders": true,
    "track_tools": true,
    "track_websites": true
  }
}
